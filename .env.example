# Optional: only needed for the Kaggle API download path in scripts/fetch_data.sh.
# Copy to .env (gitignored) and fill ONE of the two options. Never commit real values.
# Newer Kaggle token (Settings -> API -> Create New Token, value starts with KGAT):
KAGGLE_API_TOKEN=
# Older username/key pair (from kaggle.json); also read from ~/.kaggle/kaggle.json if present:
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional Step 8 scoring service (deployment settings, not secrets; defaults shown):
# directory holding models/LATEST and the released bundle
AML_MODELS_DIR=models
# maximum rows accepted by POST /score-batch (feature 002); the UI reads the value from /triage-config
AML_BATCH_LIMIT=5000
