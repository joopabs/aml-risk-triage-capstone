# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Secrets and environment
.env
.env.*
!.env.example

# Data: never committed (constitution Principle II)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# small governance records are tracked (no row-level data inside)
!data/processed/split_manifest.json
!data/processed/test_access.json
!data/processed/features_*.json
!data/processed/*.fitscope.json
*.csv
*.parquet

# Model binaries: regenerate with `make pipeline`; checksums are committed
models/**/*.joblib
models/runs/

# Submission bundle
submission/

# Scratch
*.tmp
*.swp

# local run logs
.logs/

# self-contained HTML render of the report (regenerate with make report; the PDF is the deliverable)
reports/final_report.html
reports/.final_report_pdf.html
